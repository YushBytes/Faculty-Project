# Shared editor defaults. The repository mixes Python and TypeScript; ruff and eslint remain the
# authority on formatting their own files, and these settings only keep the basics consistent.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4
max_line_length = 100

[*.md]
# Markdown uses trailing spaces for hard line breaks.
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
