# Copy to .env (repo root for Docker Compose, backend/ for running the API locally).
APP_ENV=development

# Required in production: at least 32 random characters, e.g. python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-to-a-long-random-secret-at-least-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Docker Compose
POSTGRES_USER=acadlytics
POSTGRES_PASSWORD=acadlytics
POSTGRES_DB=acadlytics
POSTGRES_PORT=5432
API_PORT=8000

# Running the API outside Docker
DATABASE_URL=postgresql+psycopg://acadlytics:acadlytics@localhost:5432/acadlytics

# Tests create and drop this database; the DB user needs CREATEDB.
TEST_DATABASE_URL=postgresql+psycopg://acadlytics:acadlytics@localhost:5432/acadlytics_test
