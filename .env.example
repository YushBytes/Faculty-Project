# Copy to .env (repo root for Docker Compose, backend/ for running the API locally).
# .env is gitignored: real passwords and secrets go there, never in this file.
APP_ENV=development

# Required in production: at least 32 random characters, e.g. python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-to-a-long-random-secret-at-least-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
# Sign-in throttle: this many wrong passwords for one email within the window -> 429 until it
# passes (0 disables). Per API process; add a reverse-proxy limit in production.
LOGIN_MAX_FAILURES=10
LOGIN_WINDOW_SECONDS=900

# Docker Compose. Host ports avoid the common 5432 / 3000 so ACADLYTICS can run next to
# other local projects; change them here if they are taken.
POSTGRES_USER=acadlytics
POSTGRES_PASSWORD=acadlytics
POSTGRES_DB=acadlytics
POSTGRES_PORT=55432
API_PORT=8000
WEB_PORT=3001

# Running the API outside Docker
DATABASE_URL=postgresql+psycopg://acadlytics:acadlytics@localhost:55432/acadlytics

# Tests create and drop this database; the DB user needs CREATEDB.
TEST_DATABASE_URL=postgresql+psycopg://acadlytics:acadlytics@localhost:55432/acadlytics_test

# Web (Next.js). Where the web server forwards /api/v1 and the session routes when it runs
# outside Docker (Compose sets it to the api container itself).
ACADLYTICS_API_URL=http://localhost:8000

# The first Administrator, created on start when no Administrator exists. There is no built-in
# password: set one (8+ characters) before the first start, or nothing is created.
ACADLYTICS_ADMIN_EMAIL=admin@acadlytics.dev
ACADLYTICS_ADMIN_PASSWORD=

# Faculty logins created from TLP reports are <staff id>@INSTITUTION_EMAIL_DOMAIN. Leave
# FACULTY_DEFAULT_PASSWORD empty and an Administrator/HOD sets each password in People (admin/users);
# set it and new faculty accounts start with it (they change it in Settings).
FACULTY_DEFAULT_PASSWORD=
INSTITUTION_EMAIL_DOMAIN=srmist.edu.in
